{
  "name": "pdf-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-only PDF tools (merge, split, sign, convert, compress, watermark). No backend, deployable to GitHub Pages.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/manrope": "^5.2.0",
    "fflate": "^0.8.2",
    "lucide-react": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "signature_pad": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
